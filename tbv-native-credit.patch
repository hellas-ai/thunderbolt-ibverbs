# Native credit-window / batch enlargement (2026-09-11, measured)
#
# Throughput was capped at ~700-850 MB/s by the E2E credit loop: the
# receiver returns credits in batches of 32 (TBV_NATIVE_DATA_CREDIT_BATCH)
# and the window was 768 x 4 KB (rx_ring_size 1024 minus a 256 reserve).
# 62,655 credit stalls were counted in a single 1 MB x 2000 run; the sender
# spent most of the run waiting for 32-credit refills.
#
# batch 32->256, native ring 1024->4096 (window 3840):
#   64 KB:  850 -> 1090 MB/s  (+28%)
#   256 KB: 768 -> 1162 MB/s  (+51%)
#   1 MB:   573 -> ~600 MB/s  (+6%, then per-frame completion bound)
#
# Generated by diffing d740562 (pristine) + tbv-apple-nhi-throttle.patch
# against the deployed 7.1.13-usb4gpu tree.
#
--- a/proto/native_data.h
+++ b/proto/native_data.h
@@ -11,7 +11,7 @@
 #define TBV_NATIVE_DATA_MAX_PAYLOAD \
 	(TBV_NATIVE_DATA_FRAME_SIZE - TBV_NATIVE_DATA_HDR_SIZE)
 #define TBV_NATIVE_DATA_MAX_MSG_SIZE	(16u * 1024u * 1024u)
-#define TBV_NATIVE_DATA_CREDIT_BATCH	32u
+#define TBV_NATIVE_DATA_CREDIT_BATCH	256u
 #define TBV_NATIVE_DATA_MAX_FRAGS \
 	((TBV_NATIVE_DATA_MAX_MSG_SIZE + TBV_NATIVE_DATA_MAX_PAYLOAD - 1u) / \
 	 TBV_NATIVE_DATA_MAX_PAYLOAD)

--- a/kernel/path.c
+++ b/kernel/path.c
@@ -13,7 +13,7 @@
 #include "../proto/native_data.h"
 #include "tbv.h"
 
-#define TBV_NATIVE_RING_SIZE 1024
+#define TBV_NATIVE_RING_SIZE 4096
 /* Apple-originated bursts can exhaust a 256-entry RX ring before credits
  * recycle. 1024 entries passed checked Mac-to-Linux UC bursts beyond one full
  * ring while keeping per-direction buffer cost modest.
